 194          // 写字符: c_page 为当前页, c_column 为当前列, num 为字符数, offset 为所取字符在缓冲区中的偏移单位
 195          void display_zf(uchar c_page, uchar c_column, uchar num, uchar offset)
 196          {
 197   1          uchar c1, c2, c3;
 198   1          for(c1 = 0; c1 < num; c1++)
 199   1          {
 200   2              for(c2 = 0; c2 < 2; c2++)
 201   2              {
 202   3                  for(c3 = 0; c3 < 8; c3++)
 203   3                  {
 204   4                      send_cmd(lcdpage + c_page + c2);
 205   4                      send_cmd(lcdcolumn + c_column + c1 * 8 + c3);
 206   4                      send_data(table_zf[(c1 + offset) * 16 + c2 * 8 + c3]);
 207   4                  }
 208   3              }
 209   2          }
 210   1      }
 211          
 212          // 写汉字: c_page 为当前页, c_column 为当前列, num 为字符数, offset 为所取汉字在缓冲区中的偏移单位
 213          void display_hz(uchar c_page, uchar c_column, uchar num, uchar offset)
 214          {
 215   1          uchar c1, c2, c3;
 216   1          for(c1 = 0; c1 < num; c1++)
 217   1          {
 218   2              for(c2 = 0; c2 < 2; c2++)
 219   2              {
 220   3                  for(c3 = 0; c3 < 16; c3++)
 221   3                  {
 222   4                      send_cmd(lcdpage + c_page + c2);
 223   4                      send_cmd(lcdcolumn + c_column + c1 * 16 + c3);
 224   4                      send_data(table_hz[(c1 + offset) * 32 + c2 * 16 + c3]);
 225   4                  }
 226   3              }
 227   2          }
 228   1      }
