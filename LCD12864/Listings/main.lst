 129          // 延时 10 us 函数
 130          void delayus10(void)
 131          {
 132   1          uchar i = 5;
 133   1          while(--i);
 134   1      }
 135          
 136          // 延时 10 ms 函数 (原书此处写为 delayms，实为粗略延时循环)
 137          void delayms(uint j)
 138          {
 139   1          uchar i = 250;
 140   1          for(; j > 0; j--)
 141   1          {
 142   2              while(--i); i = 249; while(--i); i = 250;
 143   2          }
 144   1      }
 145          
 146          // 屏幕选择: cs=0 选择双屏, cs=1 选择左半屏, cs=2 选择右半屏
 147          void select(uchar cs)
 148          {
 149   1          if(cs == 0)      { cs1 = 1; cs2 = 1; }
 150   1          else if(cs == 1) { cs1 = 1; cs2 = 0; }
 151   1          else             { cs1 = 0; cs2 = 1; }
 152   1      }
 153          
 154          // 写命令函数
 155          void send_cmd(uchar cmd)
 156          {
 157   1          rs = 0; rw = 0; bus = cmd; delayus10(); e = 1; e = 0;
 158   1      }
 159          
 160          // 写数据函数
 161          void send_data(uchar dat)
 162          {
 163   1          rs = 1; rw = 0; bus = dat; delayus10(); e = 1; e = 0;
 164   1      }
 165          
 166          // 清屏函数
 167          void clear_screen(void)
 168          {
 169   1          uchar c_page, c_column;
 170   1          select(0);
 171   1          for(c_page = 0; c_page < c_page_max; c_page++)
 172   1          {
 173   2              send_cmd(c_page + lcdpage);
 174   2              send_cmd(lcdcolumn);
 175   2              for(c_column = 0; c_column < c_column_max; c_column++)
 176   2              {
 177   3                  send_data(0x00);
 178   3              }
