   8          volatile unsigned char key_slow;//按键减速专用
   9          unsigned char key_val,key_down,key_up,key_old;
  10          volatile unsigned char led_pos;
  11          unsigned char led[4] = {0};
  12          volatile unsigned char led_pwm = 0;
  13          
  14          unsigned char mode;//0-流水灯 1-呼吸灯
  15          unsigned char gear = 0;//呼吸灯挡位，共5档
  16          volatile unsigned int Time_500ms;
  17          
  18          bit led_flash = 0;//LED闪烁使能
  19          volatile bit Time_500ms_flag;
  20          bit led_water = 0;//0-从上到下 1-从下到上
  21          
  22          //按键处理函数
  23          void key_proc()
  24          {
  25   1        //每10ms扫描一次，实现软件消抖
  26   1        if(key_slow)return;
  27   1        key_slow = 1;
  28   1        
  29   1        key_val = key_read();
  30   1        key_down = key_val & (key_old ^ key_val);
  31   1        key_up = ~key_val & (key_old ^ key_val);
  32   1        key_old = key_val;
  33   1        
  34   1        //key1 模式切换
  35   1        if(key_down==1)
  36   1        {
  37   2          if(++mode == 2)mode = 0;
  38   2        }
  39   1          
  40   1        //key2 流水方向切换
  41   1        if(key_down==2 && mode == 0)
  42   1        {
  43   2          led_water = ~led_water;
  44   2        }
  45   1        
  46   1        //key3和key4同时按下：切换0.5秒闪烁
  47   1        if(key_down==0x0c && mode == 1)
  48   1        {
  49   2          led_flash = ~led_flash;
  50   2        }
  51   1        else if(key_down==4 && mode == 1)
  52   1        {
  53   2          if(++gear == 5)gear = 4;
  54   2        }
C51 COMPILER V9.59.0.0   MAIN                                                              09/27/2026 17:19:49 PAGE 2   

  55   1        
  56   1        //key3 增强呼吸灯亮度，key4 减弱亮度
  57   1        else if(key_down==8 && mode == 1)
  58   1        {
  59   2          if(--gear == 255)gear = 0;
  60   2        }
  61   1        
  62   1      }
  63          
  64          void led_proc()
  65          {
  66   1        unsigned char i;
  67   1        static unsigned char water_pos = 0;
  68   1        static bit Time_500ms_old = 0;
  69   1        
  70   1        switch(mode)
  71   1        {
  72   2          case 0://流水灯
  73   2            if(Time_500ms_flag != Time_500ms_old)
  74   2            {
  75   3              Time_500ms_old = Time_500ms_flag;
  76   3              for(i=0;i<4;i++)led[i] = (i == water_pos);
  77   3      
  78   3              if(led_water)
  79   3              {
  80   4                if(++water_pos == 4)water_pos = 0;
  81   4              }
  82   3              else
  83   3              {
  84   4                if(water_pos == 0)water_pos = 3;
  85   4                else water_pos--;
  86   4              }
  87   3            }
  88   2          break;
  89   2          
  90   2          case 1://呼吸灯
  91   2            for(i=0;i<4;i++)
  92   2            {
  93   3              led[i] = (led_pwm < gear*25) && (!led_flash || Time_500ms_flag);
  94   3            }
  95   2          break;
  96   2        }
  97   1      }
  98          
  99          void Timer0_Init(void)
 100          {
 101   1          TMOD &= 0xF0;       // 清除定时器0控制位
 102   1          TMOD |= 0x01;       // 定时器0，方式1，16位定时器
 103   1      
 104   1          // 11.0592 MHz 标准12T 51，机器周期约为1.085 us
 105   1          // 1 ms计数约922次
 106   1          TH0 = 0xFC;
 107   1          TL0 = 0x66;
 108   1      
 109   1          TF0 = 0;            // 清除溢出标志
 110   1          ET0 = 1;            // 允许定时器0中断
 111   1          EA  = 1;            // 开总中断
 112   1          TR0 = 1;            // 启动定时器0
 113   1      }
 114          
 115          void Timer0_Service() interrupt 1
 116          {
C51 COMPILER V9.59.0.0   MAIN                                                              09/27/2026 17:19:49 PAGE 3   

 117   1        TH0 = 0xFC;
 118   1        TL0 = 0x66;
