#include <REGX52.H>
#include <stdio.H>
#include <intrins.H>
#include <key.H>
#include <led.H>
#include <init.H>

unsigned char key_slow;//按键减速专用
unsigned char key_val,key_down,key_up,key_old;
unsigned char led_pos;
unsigned char led[4] = {0};
unsigned char led_pwm = 0;

unsigned char mode;//0-流水灯 1-呼吸灯
unsigned char gear = 0;//呼吸灯挡位 共5档
unsigned char Time_500ms;

bit led_flash = 0;//led闪烁专用
bit Time_500ms_flag;
bit led_water = 0;//0-从上到下 1-从下到上

//按键处理函数
void key_proc()
{
	//软件延迟消抖
	//因为用了中断所以使用了定时器
	if(key_slow)return;
	key_slow = 1;
	
	key_val = key_read();
	key_down = key_val & (key_old ^ key_val);
	key_up = ~key_val & (key_old ^ key_val);
	key_old = key_val;
	
	//key1 模式切换
	if(key_down==1)
	{
		if(++mode == 3)mode = 0;
	}
		
	//key2 流水灯切换
	if(key_down==2 && mode == 0)
	{
		led_water = ~led_water;
	}
	
	//key3 呼吸灯增强亮度
	if(key_down==3 && mode == 1)
	{
		if(++gear == 5)gear = 4;
	}
	
	//key4 呼吸灯减弱亮度
	if(key_down==4 && mode == 1)
	{
		if(--gear == 255)gear = 0;
	}
	
	//key3和key4同时按下 保持当前亮度并以0.5秒间隔闪烁
	
}

void led_proc()
{
	unsigned char i,j;
	
	switch(mode)
	{
		case 0://流水灯
			if(led_water)//从上到下
			{		
				for(i=0;i<4;i++)
				{
					for(j=0;j<4;j++)
					{
						led[j] = (Time_500ms_flag)?(i==j):0;
					}
				}
			}
			else//从下到上
			{
				for(i=3;i>=0;i--)
				{
					for(j=3;j>=0;j--)
					{
						led[j] = (Time_500ms_flag)?(i==j):0;
					}
			  }
			}
		break;
		
		case 1://呼吸灯
			for(i=0;i<4;i++)
			{
				led[i] = (led_pwm < gear*25);
			}
		break;
	}
}

void Timer0_Init(void)
{
    TMOD &= 0xF0;       // 清除定时器0控制位
    TMOD |= 0x01;       // 定时器0，方式1，16位定时器

    // 11.0592 MHz 晶振，1T机器周期约为1.085 us
    // 1 ms计数约922次
    TH0 = 0xFC;
    TL0 = 0x66;

    TF0 = 0;            // 清除溢出标志
    ET0 = 1;            // 允许定时器0中断
    EA  = 1;            // 开总中断
    TR0 = 1;            // 启动定时器0
}

void Timer0_Service() interrupt 1
{
	if(++key_slow == 10)key_slow = 0;
	if(++led_pos == 4)led_pos = 0;
	led_disp(led_pos,led[led_pos]);
	
	if(++led_pwm==100)led_pwm = 0;
	
	if(++Time_500ms==500)
	{
		Time_500ms = 0;
		Time_500ms_flag ^= 1;
	}
}

int main()
{

	system_init();
	Timer0_Init();
	
	while(1)
	{
		key_proc();
		led_proc();
	}
}


